{
  "project": "WanderMark",
  "theme": {
    "archetype": "1 (Organic & Earthy)",
    "description": "Premium travel app with a coastal, sandy, and nautical vibe. Focus on generous spacing, elegant typography, and iOS-native aesthetics.",
    "colors": {
      "background": "#F5EEE5",
      "surface": "#FFFFFF",
      "surface_secondary": "#F9F6F0",
      "primary": "#1A868C",
      "primary_light": "#2DB3B9",
      "secondary": "#E07A5F",
      "text_primary": "#1E293B",
      "text_secondary": "#64748B",
      "border": "rgba(30, 41, 43, 0.08)",
      "overlay": "rgba(0, 0, 0, 0.4)",
      "gradient_bottom": "rgba(0, 0, 0, 0.8)",
      "white": "#FFFFFF"
    }
  },
  "typography": {
    "font_family_display": "Playfair Display, 'New York', serif",
    "font_family_body": "System, 'SF Pro Text', sans-serif",
    "scale": {
      "h1_hero": {
        "size": 32,
        "weight": "700",
        "family": "display",
        "line_height": 38,
        "letter_spacing": 0.5
      },
      "h2_section": {
        "size": 20,
        "weight": "700",
        "family": "body",
        "line_height": 26,
        "letter_spacing": -0.5
      },
      "h3_card_title": {
        "size": 18,
        "weight": "600",
        "family": "body",
        "line_height": 24,
        "letter_spacing": -0.2
      },
      "body": {
        "size": 16,
        "weight": "400",
        "family": "body",
        "line_height": 24,
        "letter_spacing": 0
      },
      "meta_label": {
        "size": 13,
        "weight": "500",
        "family": "body",
        "line_height": 18,
        "letter_spacing": 0.2
      },
      "badge": {
        "size": 11,
        "weight": "700",
        "family": "body",
        "text_transform": "uppercase",
        "letter_spacing": 1.0
      }
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48,
    "screen_margin": 16
  },
  "components": {
    "card_dna": {
      "border_radius": 16,
      "background_color": "#FFFFFF",
      "border_width": 1,
      "border_color": "rgba(30, 41, 43, 0.08)",
      "shadow": {
        "ios": {
          "shadowColor": "#000",
          "shadowOffset": { "width": 0, "height": 4 },
          "shadowOpacity": 0.06,
          "shadowRadius": 12
        },
        "android": {
          "elevation": 2
        }
      },
      "overflow": "hidden"
    },
    "community_highlight_hero": {
      "aspect_ratio": 0.8,
      "width": "100%",
      "gradient_overlay": ["transparent", "rgba(0,0,0,0.8)"],
      "content_position": "absolute_bottom",
      "padding": 20
    },
    "carousel_card": {
      "width": "72%",
      "aspect_ratio": 0.8,
      "snap_alignment": "start",
      "margin_right": 16
    },
    "custom_trip_badge": {
      "background": "rgba(0, 0, 0, 0.4)",
      "backdrop_filter": "blur(10px)",
      "border_radius": 100,
      "padding_horizontal": 10,
      "padding_vertical": 4,
      "text_color": "#FFFFFF",
      "icon": "sparkles"
    },
    "section_header": {
      "layout": "row_space_between",
      "margin_bottom": 16,
      "title_color": "#1E293B",
      "link_color": "#1A868C",
      "link_text": "See all \u2192",
      "icon_color": "#E07A5F"
    },
    "explore_cta_banner": {
      "aspect_ratio": 2.0,
      "border_radius": 16,
      "gradient_overlay": ["rgba(26, 134, 140, 0.1)", "rgba(26, 134, 140, 0.8)"],
      "text_color": "#FFFFFF"
    }
  },
  "layouts": {
    "social_tab": {
      "description": "Home of the new Community Highlight Hero.",
      "structure": [
        "Header (Social)",
        "Community Highlight Hero (Dynamic daily/weekly pick)",
        "Feed/Other Social Content"
      ]
    },
    "community_page": {
      "description": "Unified horizontal carousels replacing mixed layouts.",
      "structure": [
        "Section: Trending Landmarks (Carousel)",
        "Section: Recent Photos (Carousel)",
        "Section: Most Popular (Carousel)"
      ],
      "carousel_props": {
        "horizontal": true,
        "showsHorizontalScrollIndicator": false,
        "snapToInterval": "card_width + spacing",
        "decelerationRate": "fast",
        "contentContainerStyle": { "paddingHorizontal": 16 }
      }
    },
    "dedicated_highlight_page": {
      "path": "/community-highlights",
      "description": "Immersive detail view of the featured visit.",
      "structure": [
        "Full-width Hero Image (Parallax scroll)",
        "Action Bar (Like, Comment, Share) - Sticky or fixed bottom",
        "Visit Details (Location, Date, Story)",
        "User Profile Row",
        "Comments Section Preview",
        "Large CTA Button: 'See the top 10 all time \u2192'"
      ]
    },
    "top_10_page": {
      "path": "/community-highlights/top",
      "description": "Ranked grid of all-time best community photos.",
      "structure": [
        "Header: Top 10 All-Time",
        "Masonry or 2-column Grid",
        "Card Aspect Ratio: 1:1 (Square)",
        "Ranking Badge (1-10) top-left of each card"
      ]
    }
  },
  "motion_and_interactions": {
    "card_press": {
      "activeOpacity": 0.9,
      "transform": [{ "scale": 0.97 }],
      "animation": "spring"
    },
    "hero_entrance": {
      "animation": "fade_in_up",
      "duration": 600,
      "easing": "ease-out"
    }
  },
  "innovation_suggestions": [
    "Swipeable Filter Pills: On the Community page, add a sticky top row of pills (e.g., 'All', 'Landmarks', 'Nature', 'Cities') to filter the carousels without leaving the page.",
    "Haptic Feedback: Trigger a light haptic bump (UIImpactFeedbackGenerator) when snapping to a new card in the carousel, and a success haptic when liking a photo.",
    "Parallax Hero: On the dedicated /community-highlights page, make the hero image scale up slightly as the user scrolls down (pull-to-refresh gesture)."
  ],
  "media": {
    "image_urls": [
      {
        "category": "hero_landmark",
        "url": "https://images.pexels.com/photos/18471697/pexels-photo-18471697.jpeg",
        "description": "Tourist exploring Colosseum - use for Community Highlight testing"
      },
      {
        "category": "carousel_landmark",
        "url": "https://images.pexels.com/photos/18111185/pexels-photo-18111185.jpeg",
        "description": "Tower Bridge London - use for Trending Landmarks testing"
      },
      {
        "category": "user_avatar_1",
        "url": "https://images.pexels.com/photos/3768907/pexels-photo-3768907.jpeg",
        "description": "Female tourist portrait - use for user avatar on cards"
      },
      {
        "category": "user_avatar_2",
        "url": "https://images.pexels.com/photos/20319700/pexels-photo-20319700.jpeg",
        "description": "Female tourist portrait - use for comment section testing"
      },
      {
        "category": "explore_cta_background",
        "url": "https://images.pexels.com/photos/1106437/pexels-photo-1106437.jpeg",
        "description": "Coastal aerial landscape - use for Explore page CTA banner"
      }
    ]
  },
  "instructions_to_main_agent": [
    "Strictly use the 'Card DNA' spec for all photo cards (Trending, Recent, Popular, Top 10) to maintain visual consistency.",
    "Ensure 'react-native-paper' Surface components use elevation: 0 on iOS and manual shadow styles for the premium iOS feel.",
    "The Custom Trip badge must be clearly visible over images; use the semi-transparent dark pill style.",
    "Replace the 'Community Highlights' on the Explore page with the single CTA banner as specified.",
    "Implement horizontal FlatLists with snapToInterval for all Community page sections.",
    "All interactive elements MUST have a data-testid attribute in kebab-case for testing."
  ]
}