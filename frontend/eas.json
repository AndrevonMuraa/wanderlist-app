{
  "cli": {
    "version": ">= 13.2.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://wandermark-api.onrender.com"
      },
      "ios": {
        "simulator": false,
        "resourceClass": "default"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://wandermark-api.onrender.com"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://wandermark-api.onrender.com"
      },
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "preview": {},
    "production": {}
  }
}
